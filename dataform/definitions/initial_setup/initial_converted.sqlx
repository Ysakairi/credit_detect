config {
  type: "table",
  schema: "dwh_prod",
  name: "ulb_fraud_detection_converted",
  description: "Full public dataset with Hour and pseudo Date 1-50",
  tags: ["initial_setup"]
}

-- 初期設定(1) 公開データのローカルコピーから成形する
-- 公開表は US、dwh_prod は asia-northeast1 のため Dataform から直接は読めない
-- Date の割り当ては batch_app/daily_insert.py と一致させること

SELECT
  *,
  MOD(CAST(FLOOR(Time / 3600) AS INT64), 24) AS Hour,
  -- ROW_NUMBER は 1 始まりのため -1 して 0 始まりにし、50 で割った余り + 1
  -- Time の同値行で非決定的にならないよう Amount, V1 でタイブレークする
  MOD(ROW_NUMBER() OVER (ORDER BY Time, Amount, V1) - 1, 50) + 1 AS Date
FROM
  ${ref("ulb_fraud_detection_public")}
WHERE
  Time IS NOT NULL
