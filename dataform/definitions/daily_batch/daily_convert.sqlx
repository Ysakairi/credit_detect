config {
  type: "table",
  schema: "dwh_prod",
  name: "ulb_fraud_detection_daily_converted",
  description: "Feature engineering for the daily batch slice",
  tags: ["daily_batch"]
}

-- 日次バッチ(2) Cloud Run Jobs が作成した ulb_fraud_detection_Batch を成形する
-- 初期セットアップの ulb_fraud_detection_converted とは別名にし、Dataform の
-- アクション名衝突と学習データの上書きを防ぐ

SELECT
  *,
  -- Time は公開データ上 0 以上。FLOOR で正の値の切り捨てを明示する
  MOD(CAST(FLOOR(Time / 3600) AS INT64), 24) AS Hour
FROM
  ${ref("ulb_fraud_detection_Batch")}
WHERE
  Time IS NOT NULL
