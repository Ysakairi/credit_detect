config {
  type: "table",
  schema: "dwh_prod",
  name: "ulb_fraud_detection_predictions",
  description: "Daily inference results with fraud probability",
  tags: ["daily_batch"]
}

-- 日次バッチ(3) 推論（予測）結果テーブルの作成
-- 学習に使っていない疑似日付 1〜31 のスライスのみを推論対象とする

SELECT
  * EXCEPT(predicted_Class_probs),
  -- label 型（INT64 / STRING）差を吸収し、不正クラス(1)の確率だけを抽出
  (
    SELECT prob
    FROM UNNEST(predicted_Class_probs)
    WHERE CAST(label AS STRING) = "1"
    LIMIT 1
  ) AS fraud_probability
FROM
  ML.PREDICT(
    MODEL `${dataform.projectConfig.defaultDatabase}.${dataform.projectConfig.defaultSchema}.ulb_fraud_detection_model`,
    (
      SELECT
        *
      FROM
        ${ref("ulb_fraud_detection_daily_converted")}
      WHERE
        Date BETWEEN 1 AND 31
    )
  )
